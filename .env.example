# SportsGameOdds
SPORTS_GAME_ODDS_API_KEY=replace_me

# Calendar-day filtering
APP_TIMEZONE=America/Chicago

# Comma-separated leagueIDs to query (this subscription tier requires at
# least one leagueID or eventID on every SportsGameOdds /events request).
LEAGUE_IDS=NFL,MLB,NBA

# Kalshi
KALSHI_ENVIRONMENT=production

# Net EV: whole contracts per position, filled together at the displayed ask.
EV_CONTRACTS=1
# Standard taker multiplier for the currently supported sports series.
# Set explicitly if your market has a different fee schedule.
KALSHI_TAKER_FEE_MULTIPLIER=1
# Direct account: 0.0001; non-direct/FCM-cleared account: 0.01.
KALSHI_BALANCE_PRECISION=0.0001

# Needed only if authenticated Kalshi functionality is added later.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private.key
