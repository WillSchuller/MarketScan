# SportsGameOdds
SPORTS_GAME_ODDS_API_KEY=replace_me

# Calendar-day filtering
APP_TIMEZONE=America/Chicago

# Comma-separated leagueIDs to query (this subscription tier requires at
# least one leagueID or eventID on every SportsGameOdds /events request).
LEAGUE_IDS=NFL,MLB,NHL

# Kalshi
KALSHI_ENVIRONMENT=production

# Needed only if authenticated Kalshi functionality is added later.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private.key
